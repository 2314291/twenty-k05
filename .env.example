# Sao chép thành .env (KHÔNG commit .env). Mọi script đọc biến này.
# Địa chỉ gốc của Twenty chạy local (mapping 3001:3000 trong env/docker-compose.yml)
TWENTY_BASE_URL=http://localhost:3001

# API key tạo trong Twenty: Settings -> (mục API) -> tạo key. Dán vào .env, không dán vào chat/commit.
TWENTY_API_KEY=

# Key thứ hai gắn role giới hạn (chỉ đọc) dùng cho SC5. Để trống nếu chưa tạo.
TWENTY_API_KEY_LIMITED=

# Seed ngẫu nhiên cố định để chạy lại cho kết quả giống nhau
K05_SEED=20261020
